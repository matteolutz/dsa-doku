// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  AL
  KL
  TN
}

model User {
  id Int @id @default(autoincrement())

  name          String?
  email         String?   @unique
  emailVerified DateTime?

  firstName   String
  lastName    String
  permissions BigInt

  userRole UserRole

  password          String
  registrationCodes RegistrationCode[]

  courseParticipations CourseParticipation[]
  academyALs           AcademyAL[]
}

model RegistrationCode {
  code String @unique

  userRole UserRole
  courseId Int?

  allowReuse Boolean

  usedById Int?
  usedBy   User? @relation(fields: [usedById], references: [id])
}

model Academy {
  id       Int    @id @default(autoincrement())
  location String

  year    Int
  yearIdx Int

  courses    Course[]
  academyALs AcademyAL[]

  documents Document[]

  @@unique([year, yearIdx])
  @@unique([location, year])
}

model AcademyAL {
  academyId Int
  academy   Academy @relation(fields: [academyId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  @@id([academyId, userId])
}

model Course {
  id Int @id @default(autoincrement())

  academyId Int
  academy   Academy @relation(fields: [academyId], references: [id])

  title    String
  subtitle String

  courseIdx Int

  courseParticipations CourseParticipation[]

  documents Document[]
}

model CourseParticipation {
  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  @@id([courseId, userId])
}

enum DocumentCategory {
  AL_PREFACE
  KUMU
  COURSE
  KUA
}

model Document {
  id String @id

  academyId Int
  academy   Academy @relation(fields: [academyId], references: [id])

  title    String
  category DocumentCategory

  courseId Int?
  course   Course? @relation(fields: [courseId], references: [id])

  startingPageNumber Int
  numberOfPages      Int
  originalFileName   String

  sortOrder Int // Sorting order inside the
}
